<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.example.examenmvvmluna.MainActivity">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:text="@string/time"
        app:layout_constraintTop_toBottomOf="@id/horiz0"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:textSize="18sp"
        android:textStyle="bold"
        android:text="@string/taskmate"
        app:layout_constraintTop_toBottomOf="@id/horiz0"
        app:layout_constraintStart_toEndOf="@id/vert0"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:textSize="20sp"
        android:textStyle="bold"
        android:text="@string/Saludos"
        app:layout_constraintTop_toBottomOf="@id/horiz2"
        app:layout_constraintStart_toEndOf="@id/vert0"
        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:textSize="15sp"
        android:text="@string/tareas_pendientes"
        app:layout_constraintTop_toBottomOf="@id/horiz3"
        app:layout_constraintStart_toEndOf="@id/vert0"
        />

    <Button
        android:id="@+id/but1"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:text="@string/todas"
        app:layout_constraintTop_toBottomOf="@id/horiz1"
        app:layout_constraintStart_toEndOf="@id/verttask2"
        />

    <Button
        android:id="@+id/but2"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:text="@string/pendientes"
        android:backgroundTint="@color/design_default_color_secondary"
        app:layout_constraintTop_toBottomOf="@id/horiz1"
        app:layout_constraintStart_toEndOf="@id/but1"
        />

    <Button
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:text="@string/completadas"
        android:backgroundTint="@color/design_default_color_secondary"
        app:layout_constraintTop_toBottomOf="@id/horiz1"
        app:layout_constraintStart_toEndOf="@id/but2"
        />

    <CheckBox
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        app:layout_constraintStart_toEndOf="@+id/vert0"
        app:layout_constraintTop_toBottomOf="@+id/horiz5"
        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:textSize="15sp"
        android:text="@string/ma_ana_09_00"
        app:layout_constraintTop_toBottomOf="@id/task3"
        app:layout_constraintStart_toEndOf="@id/vert1"
        />

    <Button
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:text="@string/baja"
        app:layout_constraintStart_toEndOf="@id/vert3"
        app:layout_constraintTop_toBottomOf="@id/horiz7"/>

    <CheckBox
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        app:layout_constraintStart_toEndOf="@+id/vert0"
        app:layout_constraintTop_toBottomOf="@+id/horiz8"
        />

    <TextView

        android:text="@string/estudiar_android_xml"
        app:layout_constraintTop_toBottomOf="@id/horiz5"
        app:layout_constraintStart_toEndOf="@id/vert1"
        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:textSize="15sp"
        android:text="@string/hoy_10_00"
        app:layout_constraintTop_toBottomOf="@id/task1"
        app:layout_constraintStart_toEndOf="@id/vert1"
        />

    <Button
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:text="@string/alta"
        app:layout_constraintStart_toEndOf="@id/vert3"
        app:layout_constraintTop_toBottomOf="@id/horiz6"/>

    <CheckBox
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        app:layout_constraintStart_toEndOf="@+id/vert0"
        app:layout_constraintTop_toBottomOf="@+id/horiz6"
        />

    <TextView
        android:id="@+id/task2"
        android:layout_width="wrap_content"

        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:textSize="15sp"
        android:text="@string/hoy_18_00"
        app:layout_constraintTop_toBottomOf="@id/task2"
        app:layout_constraintStart_toEndOf="@id/vert1"
        />

    <Button
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:text="@string/media"
        app:layout_constraintStart_toEndOf="@id/vert3"
        app:layout_constraintTop_toBottomOf="@id/horiz5"/>

